# Tawassl Security Studio Environment Configuration
# Local-first security workspace - keep secrets on backend only

# Server configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security & CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_API_SECRET=change-this-local-secret-for-session-tokens-in-production

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/tawassl.db
DATA_DIR=./data
WORKER_SANDBOX_DIR=./data/sandbox

# AI Providers (optional - MockProvider is used when keys are omitted)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=mock
DEFAULT_MODEL_ID=mock-sec-v1

# Global Safety & Budget Defaults
DEFAULT_MAX_STEPS=20
DEFAULT_MAX_REQUESTS=50
DEFAULT_MAX_TOOL_CALLS=30
DEFAULT_TIMEOUT_SECONDS=300
DEFAULT_MAX_OUTPUT_BYTES=2097152
